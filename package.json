  },
  "files": ["bin", "src", "schema", "starter", "copilot", "templates", "docs"],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "figma:build": "node figma-plugin/build.mjs",
    "check:figma": "node figma-plugin/build.mjs --check"
  },
