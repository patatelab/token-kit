{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "token-kit-bundle.schema.json",
  "title": "token-kit bundle (*.tokens.bundle.json)",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "exportedAt",
    "source",
    "config",
    "tokens",
    "checksum"
  ],
  "properties": {
    "format": {
      "const": "token-kit-bundle"
    },
    "version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "tree",
        "flat"
      ],
      "description": "tree: DTCG token tree (CLI). flat: path -> token map (Figma plugin)."
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "basedOn": {
          "type": "string"
        },
        "newTokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "config": {
      "$ref": "token-kit.config.schema.json"
    },
    "tokens": {
      "type": "object"
    },
    "baselines": {
      "type": "object",
      "properties": {
        "ratchet": {
          "type": "object"
        },
        "knownErrors": {
          "type": "object"
        }
      }
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 over the tokens as canonical JSON (sorted keys)."
    },
    "contracts": {
      "type": "object",
      "description": "Root $extensions of the token tree (flat bundles only): cssAliases, basicAliases, componentContexts."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "flat"
          }
        }
      },
      "then": {
        "properties": {
          "tokens": {
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "value": {},
                "tier": {
                  "enum": [
                    "primitive",
                    "scale",
                    "basic",
                    "component"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "extensions": {
                  "type": "object"
                },
                "themes": {
                  "type": "object"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "themes"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
