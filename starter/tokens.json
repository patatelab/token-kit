{
  "$description": "Example token set created by token-kit init. Replace the foundations to retheme; keep roles stable.",
  "foundations": {
    "$extensions": {
      "pathSkip": true
    },
    "$description": "Primitives (literal values) and Scales (aliases between Primitives). Never consumed by components directly.",
    "palette": {
      "$type": "color",
      "$description": "Colour Primitives.",
      "neutral": {
        "0": {
          "$value": "#FFFFFF"
        },
        "50": {
          "$value": "#F7F7F8"
        },
        "100": {
          "$value": "#EDEDF0"
        },
        "200": {
          "$value": "#DCDCE1"
        },
        "400": {
          "$value": "#9A9AA5"
        },
        "600": {
          "$value": "#5C5C66"
        },
        "700": {
          "$value": "#43434B"
        },
        "800": {
          "$value": "#2C2C32"
        },
        "900": {
          "$value": "#18181C"
        },
        "950": {
          "$value": "#0F0F12"
        },
        "1000": {
          "$value": "#000000"
        }
      },
      "brand": {
        "400": {
          "$value": "#5B8DEF"
        },
        "500": {
          "$value": "#2563EB"
        },
        "600": {
          "$value": "#1D4ED8"
        }
      },
      "red": {
        "600": {
          "$value": "#DC2626"
        },
        "300": {
          "$value": "#FCA5A5"
        }
      },
      "green": {
        "600": {
          "$value": "#16A34A"
        },
        "300": {
          "$value": "#86EFAC"
        }
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Dimension Primitives on a 4px grid.",
      "0": {
        "$value": "0rem"
      },
      "1": {
        "$value": "0.25rem"
      },
      "2": {
        "$value": "0.5rem"
      },
      "3": {
        "$value": "0.75rem"
      },
      "4": {
        "$value": "1rem"
      },
      "6": {
        "$value": "1.5rem"
      },
      "8": {
        "$value": "2rem"
      },
      "12": {
        "$value": "3rem"
      }
    },
    "spacing": {
      "$type": "dimension",
      "$description": "Spacing Scale: one step per layout rhythm.",
      "0": {
        "$value": "{size.0}"
      },
      "1": {
        "$value": "{size.1}"
      },
      "2": {
        "$value": "{size.2}"
      },
      "3": {
        "$value": "{size.3}"
      },
      "4": {
        "$value": "{size.4}"
      },
      "5": {
        "$value": "{size.6}"
      },
      "6": {
        "$value": "{size.8}"
      },
      "7": {
        "$value": "{size.12}"
      }
    },
    "corner": {
      "$type": "dimension",
      "$description": "Radius Primitives.",
      "1": {
        "$value": "0.25rem"
      },
      "2": {
        "$value": "0.5rem"
      },
      "3": {
        "$value": "0.75rem"
      },
      "round": {
        "$value": "999px"
      }
    },
    "stroke-width": {
      "$type": "dimension",
      "$description": "Stroke Primitives.",
      "thin": {
        "$value": "1px"
      },
      "thick": {
        "$value": "2px"
      }
    },
    "font-scale": {
      "$type": "dimension",
      "$description": "Type size Primitives.",
      "1": {
        "$value": "0.875rem"
      },
      "2": {
        "$value": "1rem"
      },
      "3": {
        "$value": "1.125rem"
      },
      "4": {
        "$value": "1.5rem"
      },
      "5": {
        "$value": "2rem"
      }
    },
    "font-weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 700
      }
    },
    "font-family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "monospace"
        ]
      }
    },
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "base": {
        "$value": "200ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
  },
  "color": {
    "$type": "color",
    "$description": "Semantic Basic colour roles. Dark values live under dark-mode.",
    "background": {
      "default": {
        "$value": "{palette.neutral.0}",
        "$description": "Default page and surface background."
      },
      "subtle": {
        "$value": "{palette.neutral.50}",
        "$description": "Quiet background for grouped content."
      },
      "inverse": {
        "$value": "{palette.neutral.900}",
        "$description": "Background that contrasts with the default theme."
      }
    },
    "text": {
      "default": {
        "$value": "{palette.neutral.900}",
        "$description": "Primary text."
      },
      "muted": {
        "$value": "{palette.neutral.600}",
        "$description": "Secondary text and metadata."
      },
      "inverse": {
        "$value": "{palette.neutral.0}",
        "$description": "Text on inverse backgrounds."
      }
    },
    "border": {
      "default": {
        "$value": "{palette.neutral.200}",
        "$description": "Default divider and outline colour."
      }
    },
    "brand": {
      "primary": {
        "$value": "{palette.brand.500}",
        "$description": "Primary brand and action colour."
      },
      "on-primary": {
        "$value": "{palette.neutral.0}",
        "$description": "Text and icons on the primary brand colour."
      }
    },
    "feedback": {
      "error": {
        "$value": "{palette.red.600}",
        "$description": "Error text and icons."
      },
      "success": {
        "$value": "{palette.green.600}",
        "$description": "Success text and icons."
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Semantic spacing roles; one primary role per Spacing Scale step.",
    "inline-gap": {
      "$value": "{spacing.1}",
      "$description": "Gap between inline items such as icon and label."
    },
    "component-gap": {
      "$value": "{spacing.2}",
      "$description": "Gap inside a component."
    },
    "gutter": {
      "$value": "{spacing.4}",
      "$description": "Default layout inset and gap."
    },
    "section": {
      "$value": "{spacing.6}",
      "$description": "Distance between page sections."
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Semantic corner radius roles.",
    "control": {
      "$value": "{corner.2}",
      "$description": "Buttons, inputs and other controls."
    },
    "surface": {
      "$value": "{corner.3}",
      "$description": "Cards, dialogs and other surfaces."
    },
    "pill": {
      "$value": "{corner.round}",
      "$description": "Fully rounded badges and chips."
    }
  },
  "stroke": {
    "$type": "dimension",
    "$description": "Semantic stroke widths.",
    "hairline": {
      "$value": "{stroke-width.thin}",
      "$description": "Dividers and default borders."
    },
    "focus": {
      "$value": "{stroke-width.thick}",
      "$description": "Focus rings."
    }
  },
  "text": {
    "$description": "Semantic typography roles.",
    "family": {
      "$type": "fontFamily",
      "default": {
        "$value": "{font-family.sans}",
        "$description": "Default UI font."
      },
      "code": {
        "$value": "{font-family.mono}",
        "$description": "Code and tabular figures."
      }
    },
    "body": {
      "size": {
        "$value": "{font-scale.2}",
        "$type": "dimension",
        "$description": "Body text size."
      },
      "weight": {
        "$value": "{font-weight.regular}",
        "$type": "fontWeight",
        "$description": "Body text weight."
      }
    },
    "label": {
      "size": {
        "$value": "{font-scale.1}",
        "$type": "dimension",
        "$description": "Control label size."
      },
      "weight": {
        "$value": "{font-weight.medium}",
        "$type": "fontWeight",
        "$description": "Control label weight."
      }
    },
    "headline": {
      "size": {
        "$value": "{font-scale.5}",
        "$type": "dimension",
        "$description": "Page headline size."
      },
      "weight": {
        "$value": "{font-weight.bold}",
        "$type": "fontWeight",
        "$description": "Headline weight."
      }
    }
  },
  "motion": {
    "$description": "Semantic motion roles.",
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "{duration.fast}",
        "$description": "Hover and press feedback."
      },
      "base": {
        "$value": "{duration.base}",
        "$description": "Enter and exit transitions."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{easing.standard}",
        "$description": "Default easing for UI transitions."
      }
    }
  },
  "button": {
    "$description": "ButtonUI component tokens. Variants map to Basic roles only.",
    "primary": {
      "background": {
        "$value": "{color.brand.primary}",
        "$type": "color",
        "$description": "Primary button background."
      },
      "foreground": {
        "$value": "{color.brand.on-primary}",
        "$type": "color",
        "$description": "Primary button label and icon."
      }
    },
    "padding-inline": {
      "$value": "{space.gutter}",
      "$type": "dimension",
      "$description": "Horizontal padding."
    },
    "padding-block": {
      "$value": "{space.component-gap}",
      "$type": "dimension",
      "$description": "Vertical padding."
    },
    "gap": {
      "$value": "{space.inline-gap}",
      "$type": "dimension",
      "$description": "Gap between icon and label."
    },
    "radius": {
      "$value": "{radius.control}",
      "$type": "dimension",
      "$description": "Corner radius."
    },
    "font-size": {
      "$value": "{text.label.size}",
      "$type": "dimension",
      "$description": "Label size."
    },
    "font-weight": {
      "$value": "{text.label.weight}",
      "$type": "fontWeight",
      "$description": "Label weight."
    },
    "transition-duration": {
      "$value": "{motion.duration.fast}",
      "$type": "duration",
      "$description": "Hover/press transition."
    }
  },
  "card": {
    "$description": "CardUI component tokens.",
    "background": {
      "$value": "{color.background.default}",
      "$type": "color",
      "$description": "Card surface."
    },
    "border-color": {
      "$value": "{color.border.default}",
      "$type": "color",
      "$description": "Card outline."
    },
    "border-width": {
      "$value": "{stroke.hairline}",
      "$type": "dimension",
      "$description": "Card outline width."
    },
    "padding": {
      "$value": "{space.gutter}",
      "$type": "dimension",
      "$description": "Content inset."
    },
    "gap": {
      "$value": "{space.component-gap}",
      "$type": "dimension",
      "$description": "Gap between card children."
    },
    "radius": {
      "$value": "{radius.surface}",
      "$type": "dimension",
      "$description": "Corner radius."
    }
  },
  "dark-mode": {
    "$description": "Dark theme overrides of Semantic Basic roles. Components follow automatically.",
    "color": {
      "$type": "color",
      "background": {
        "default": {
          "$value": "{palette.neutral.950}"
        },
        "subtle": {
          "$value": "{palette.neutral.900}"
        },
        "inverse": {
          "$value": "{palette.neutral.0}"
        }
      },
      "text": {
        "default": {
          "$value": "{palette.neutral.50}"
        },
        "muted": {
          "$value": "{palette.neutral.400}"
        },
        "inverse": {
          "$value": "{palette.neutral.900}"
        }
      },
      "border": {
        "default": {
          "$value": "{palette.neutral.700}"
        }
      },
      "feedback": {
        "error": {
          "$value": "{palette.red.300}"
        },
        "success": {
          "$value": "{palette.green.300}"
        }
      }
    }
  }
}
